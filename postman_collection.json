{
  "info": {
    "_postman_id": "f3rva-api-collection-v1",
    "name": "F3 API",
    "description": "Postman Collection for F3 RVA modern Python serverless REST API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Base URL of the API (e.g. http://localhost:8000, https://api.dev.f3rva.org, https://api.f3rva.org)"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token for protected admin endpoints (populated after /v2/admin/login)"
    }
  ],
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns operational status, API version, and runtime environment."
          }
        },
        {
          "name": "Database Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": ["{{baseUrl}}"],
              "path": ["health", "db"]
            },
            "description": "Executes SELECT 1 against the configured MySQL database to verify connectivity."
          }
        },
        {
          "name": "OpenAPI Specification JSON",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": ["{{baseUrl}}"],
              "path": ["openapi.json"]
            },
            "description": "Retrieves the complete OpenAPI 3.1 JSON specification."
          }
        }
      ]
    },
    {
      "name": "2. Workouts & Backblasts (Phase 2)",
      "item": [
        {
          "name": "Get Recent Workouts (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/workouts?page=1&results=20",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "workouts"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-based index)"
                },
                {
                  "key": "results",
                  "value": "20",
                  "description": "Items per page (max 100)"
                }
              ]
            },
            "description": "Returns the most recent workouts ordered by date descending."
          }
        },
        {
          "name": "Get Workouts by Date (Year / Month / Day)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/workouts/by-date?year=2026&month=8&page=1&results=20",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "workouts", "by-date"],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "8"
                },
                {
                  "key": "day",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "results",
                  "value": "20"
                }
              ]
            },
            "description": "Filters workouts by year, year+month, or exact day."
          }
        },
        {
          "name": "Get Workout by Date and Slug",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/workouts/by-date-slug?year=2026&month=8&day=7&slug=beatdown-at-gridiron",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "workouts", "by-date-slug"],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "8"
                },
                {
                  "key": "day",
                  "value": "7"
                },
                {
                  "key": "slug",
                  "value": "beatdown-at-gridiron"
                }
              ]
            },
            "description": "Retrieves workout matching exact date and URL slug."
          }
        },
        {
          "name": "Get Workouts by AO (ID or Slug)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/workouts/ao/gridiron?page=1&results=20",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "workouts", "ao", "gridiron"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "results",
                  "value": "20"
                }
              ]
            },
            "description": "Retrieves paginated workouts for a specific Area of Operations."
          }
        },
        {
          "name": "Get Single Workout Detail by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/workouts/101",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "workouts", "101"]
            },
            "description": "Retrieves a single workout with complete PAX attendee list and HTML content."
          }
        }
      ]
    },
    {
      "name": "3. Members & PAX (Phase 3)",
      "item": [
        {
          "name": "Get All Members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/members",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "members"]
            },
            "description": "Retrieves an alphabetical list of all registered members."
          }
        },
        {
          "name": "Lookup Member by Name or Alias",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/members/lookup?name=dingo",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "members", "lookup"],
              "query": [
                {
                  "key": "name",
                  "value": "dingo"
                }
              ]
            },
            "description": "Searches members by primary F3 name or registered alias (case-insensitive)."
          }
        },
        {
          "name": "Get Member Profile & History by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/members/1",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "members", "1"]
            },
            "description": "Returns full member profile with aliases, attendance stats, and attended & Q'd workout history."
          }
        },
        {
          "name": "Get Member Attendance Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/members/1/stats",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "members", "1", "stats"]
            },
            "description": "Returns workout attendance count, Q count, and calculated Q-ratio (Qs / Workouts)."
          }
        }
      ]
    },
    {
      "name": "4. Reports, Leaderboards & AO Metrics (Phase 4)",
      "item": [
        {
          "name": "Attendance Leaderboard (Ranked by Workouts)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/reports/attendance?startDate=2026-01-01&endDate=2026-12-31&sortBy=workout&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "reports", "attendance"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2026-12-31"
                },
                {
                  "key": "sortBy",
                  "value": "workout",
                  "description": "Ranking metric: workout (most workouts), q (most Qs), ratio (highest Q ratio)"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Generates member attendance and Q leaderboard ranked by workout count."
          }
        },
        {
          "name": "Attendance Leaderboard (Ranked by Qs)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/reports/attendance?sortBy=q&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "reports", "attendance"],
              "query": [
                {
                  "key": "sortBy",
                  "value": "q"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Ranks members by total workouts led (Q'd)."
          }
        },
        {
          "name": "Attendance Leaderboard (Ranked by Q-Ratio)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/reports/attendance?sortBy=ratio&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "reports", "attendance"],
              "query": [
                {
                  "key": "sortBy",
                  "value": "ratio"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Ranks members by highest Q-ratio (Qs / Workouts)."
          }
        },
        {
          "name": "AO Attendance Metrics Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/reports/ao?startDate=2026-01-01&endDate=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "reports", "ao"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2026-12-31"
                }
              ]
            },
            "description": "Calculates total workouts, total PAX attendance sum, and average PAX per workout across all AOs."
          }
        },
        {
          "name": "AO Leaderboard & Active Streakers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/reports/ao/1/leaderboard?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "reports", "ao", "1", "leaderboard"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieves top Q leaders, top PAX attendees, and active consecutive attendance streaks for a specific AO."
          }
        },
        {
          "name": "Day of Week Attendance Breakdown",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/reports/day-of-week?startDate=2026-01-01&endDate=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "reports", "day-of-week"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2026-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2026-12-31"
                }
              ]
            },
            "description": "Aggregates total workouts, total PAX attendance, and average PAX per workout by day of the week (Sunday through Saturday)."
          }
        },
        {
          "name": "Member AO Attendance Distribution",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/reports/members/1/distribution",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "reports", "members", "1", "distribution"]
            },
            "description": "Calculates the breakdown of workouts attended and Q'd across every AO for a specific member."
          }
        }
      ]
    },
    {
      "name": "5. Self-Service & Admin (Phase 5)",
      "item": [
        {
          "name": "Add Workout with Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Beatdown at First Watch\",\n  \"workoutDate\": \"2026-08-07\",\n  \"qic\": \"Dingo, Lab Rat\",\n  \"pax\": \"Dingo, Lab Rat, Splinter, Swag\",\n  \"aos\": [\n    {\n      \"name\": \"First Watch\",\n      \"slug\": \"first-watch\"\n    },\n    {\n      \"name\": \"Spider Run\",\n      \"slug\": \"spider-run\"\n    }\n  ],\n  \"body\": \"<p>100 burpees and 5 miles.</p>\",\n  \"url\": \"https://f3rva.org/2026/08/07/beatdown-at-first-watch\",\n  \"author\": \"Dingo\",\n  \"slug\": \"beatdown-at-first-watch\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v2/workouts",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "workouts"]
            },
            "description": "Creates a new workout directly from structured payload data (title, workoutDate, qic, pax, aos, body, url, author, slug)."
          }
        },
        {
          "name": "Delete Workout (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/workouts/101",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "workouts", "101"]
            },
            "description": "Deletes a workout and all associated attendee, leader, AO, and detail records (Requires Bearer Token)."
          }
        },
        {
          "name": "Submit Alias Claim Request (Self-Service)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryMemberId\": 10,\n  \"aliasMemberId\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v2/aliases/request",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "aliases", "request"]
            },
            "description": "Submits a request to claim an alias name for a primary member."
          }
        },
        {
          "name": "Get Pending Alias Requests (Public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/aliases/requests",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "aliases", "requests"]
            },
            "description": "Retrieves public list of pending member alias requests for the self-service page."
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('authToken', jsonData.accessToken);",
                  "    console.log('JWT Bearer token saved to collection variable {{authToken}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v2/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "admin", "login"]
            },
            "description": "Authenticates the admin and automatically saves the signed 24h JWT bearer token into the {{authToken}} collection variable."
          }
        },
        {
          "name": "Get Pending Alias Requests (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/aliases/requests",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "admin", "aliases", "requests"]
            },
            "description": "Retrieves all pending member alias requests (requires JWT auth)."
          }
        },
        {
          "name": "Approve Alias Request (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/aliases/approve/1/2",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "admin", "aliases", "approve", "1", "2"]
            },
            "description": "Approves an alias request (primaryMemberId/aliasMemberId), merges attendance records, and deletes the duplicate member record."
          }
        },
        {
          "name": "Reject Alias Request (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/aliases/reject/1/2",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "admin", "aliases", "reject", "1", "2"]
            },
            "description": "Rejects a pending alias request (primaryMemberId/aliasMemberId)."
          }
        },
        {
          "name": "Direct Merge Members (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryMemberId\": 1,\n  \"aliasMemberId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v2/admin/members/merge",
              "host": ["{{baseUrl}}"],
              "path": ["v2", "admin", "members", "merge"]
            },
            "description": "Directly merges a duplicate member into a primary member without requiring a prior pending request (Admin only)."
          }
        }
      ]
    }
  ]
}
