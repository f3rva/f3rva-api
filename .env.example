# ==============================================================================
# F3 RVA API - Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your real database credentials in your local .env file.
# 3. .env is ignored by git and will NEVER be committed.
#
# PASSWORD ENCODING NOTE:
# If your database password contains special characters, use standard URL encoding:
#   '@' -> '%40'     '#' -> '%23'     ':' -> '%3A'
#   '/' -> '%2F'     '%' -> '%25'     '&' -> '%26'
# (Generate with: python -c "import urllib.parse; print(urllib.parse.quote_plus('your_pass'))")
# ==============================================================================

# Core Application Settings
APP_NAME=F3 RVA API
APP_VERSION=0.1.0
ENVIRONMENT=development
PORT=8000
DEBUG=false

# Database Connection URL (MySQL / Aurora)
DATABASE_URL=mysql+pymysql://your_username:your_password@your-mysql-hostname.com:3306/f3rva_bd?charset=utf8mb4

# Security & Admin Authentication
JWT_SECRET_KEY=change-me-in-production-jwt-secret-key-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Upstream F3 Nation Schedule API Integration
F3_NATION_API_KEY=your-f3-nation-api-key-here
F3_REGION_ID=25240
CLIENT_ID=f3rva-website

# Slack Integration & OpenID Connect (Sign in with Slack & Backblast Notifications)
SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_ALLOWED_TEAM_ID=T0123456789
SLACK_BACKBLAST_CHANNEL_ID=C0123456789
