# ==============================================================================
# F3 RVA API - Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your real database credentials in your local .env file.
# 3. .env is ignored by git and will NEVER be committed.
# ==============================================================================

ENVIRONMENT=development
PORT=8000

# Database Connection (Existing Remote MySQL Host)
DB_HOST=your-mysql-hostname.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=f3rva_bd
